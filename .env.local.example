# Demo mode — set both to true to skip Supabase and use in-memory sample data
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Public site URL used in WhatsApp short links (no trailing slash)
# Example: https://billing.yourdomain.com
NEXT_PUBLIC_APP_URL=https://YOUR_APP_DOMAIN

# Real Supabase (used when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ask Kayyro (AI assistant). Works with any OpenAI-compatible API that supports tool calling.
# Free option: create a key at https://console.groq.com (no card needed) and paste it here.
AI_API_KEY=your-ai-api-key
# Optional - these defaults use Groq's free Llama 3.3 70B:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# Google Gemini (also free): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash

# Card payments (Stripe, AED, monthly and yearly). Razorpay is the fallback.
# Keys: Stripe Dashboard > Developers > API keys. Use sk_test_ keys first.
# Setup steps: docs/BILLING_STRIPE.md
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# A monthly and a yearly AED price per plan (ids start with price_):
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_BUSINESS_ANNUAL=price_...

# Kayyro Collect (payment reminders). A long random secret that Supabase pg_cron sends
# to /api/collect/run every 15 minutes. Setup: docs/KAYYRO_COLLECT.md
# COLLECT_CRON_SECRET=at-least-32-random-characters
# Optional, for automatic WhatsApp through 360dialog (default shown):
# D360_BASE_URL=https://waba-v2.360dialog.io
# Optional, to read email replies (Resend receiving, see docs/KAYYRO_COLLECT.md):
# COLLECT_INBOUND_DOMAIN=reply.yourdomain.com
# RESEND_INBOUND_WEBHOOK_SECRET=whsec_...

# Metals.Dev API key (live gold/silver market reference on Today's Rates)
METALS_API_KEY=your-metals-dev-api-key

# Email invoices (optional). Without these, "Email" opens the user's own mail app
# with a PDF link. With them, invoices and reminders send in one click (and in bulk).
# Create a free key at https://resend.com and verify your sending domain there.
RESEND_API_KEY=re_your_key
EMAIL_FROM="Kayyro <invoices@your-domain.com>"
